# RetinaGuide XAI backend settings (template: placeholders only)
# Copy to .env and edit .env. NEVER put real secrets in this file.
# Decision support only. Not a diagnosis.

APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=sqlite:///./screening.db
STORAGE_DIR=storage

# Engine Selection:
# true  = demo/stub engine data. Fast, zero-dependency mode for testing and local dev.
# false = live MATLAB R2026b engine with EfficientNet-B0 ONNX inference and real Grad-CAM.
#         Requires MATLAB Engine for Python installed and verified ONNX model at deployment_package.
#         Never falls back silently to fake data. If startup fails, engine status reports 'down'.
# Forbidden: MATLAB_FAKE=true when APP_ENV=production.
MATLAB_FAKE=true

AUTH_ENABLED=true
# Must be at least 32 random characters or startup is refused.
# Generate straight into .env without printing it:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME

# PROVISIONAL (2) pending clinician confirmation. Required, integer 0-4.
REFERABLE_MIN_GRADE=2

MAX_UPLOAD_MB=15
MIN_IMAGE_SIDE_PX=256
MAX_IMAGE_PIXELS=60000000
LOW_CONFIDENCE_THRESHOLD=0.60

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_HOURS=8
# Must be true in production (HTTPS only).
COOKIE_SECURE=false
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=10

RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_UPLOAD_PER_MIN=20
RATE_LIMIT_DEFAULT_PER_MIN=240

MATLAB_STARTUP_TIMEOUT_S=180
MATLAB_JOB_TIMEOUT_S=120
MATLAB_SIM_TIMEOUT_S=600
MAX_WAITING_ANALYSES=50
SWEEP_INTERVAL_S=300

# Exact origins only, comma-separated, never "*".
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Evaluation targets are shown next to results, never stored as pass/fail.
# Empty by default on purpose. Real numbers come from the project lead.
# EVALUATION_TARGETS={"sensitivity": 0.0, "specificity": 0.0}

# First run only: seed one admin, then DELETE these two lines from .env.
# INITIAL_ADMIN_EMAIL=admin@example.com
# INITIAL_ADMIN_PASSWORD=choose-a-long-unique-password